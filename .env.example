# Copy to .env for local runs. All settings are prefixed TRIAGE_ (except the Anthropic ones).
# NEVER commit .env or paste real keys into chats/zips.
TRIAGE_BACKEND=local            # local = in-memory stores + heuristic models; aws = real services
TRIAGE_AWS_REGION=eu-west-1
TRIAGE_ACCEPTANCE_THRESHOLD=0.75
TRIAGE_MIN_GROUNDING_SCORE=0.35
# JSON list; only needed if the UI is served from a different origin than the API
# TRIAGE_CORS_ORIGINS=["http://localhost:5173"]

# --- Anthropic API (optional; only used by app/classification/Anthropic.py, which is not wired in yet) ---
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# --- aws backend only ---
TRIAGE_OPENSEARCH_ENDPOINT=https://xxxx.eu-west-1.aoss.amazonaws.com
TRIAGE_KB_BUCKET=
TRIAGE_TICKETS_TABLE=triage-tickets
TRIAGE_TICKETS_DECISION_INDEX=decision-index
TRIAGE_FEEDBACK_TABLE=triage-feedback
TRIAGE_LLM_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
TRIAGE_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
